# Copy to deploy/.env.staging on the host; NEVER commit the real file.
# This deploys ONLY the API, not the Firecracker host, terminal, or worker.
DATABASE_URL=postgresql://cornod_app:REPLACE_WITH_LONG_SECRET@YOUR_PRIVATE_DB_HOST:5432/cornod
OIDC_ISSUER=https://YOUR_OIDC_ISSUER
OIDC_AUDIENCE=cornod-api
OIDC_JWKS_URL=https://YOUR_OIDC_ISSUER/.well-known/jwks.json
OIDC_REQUIRED_SCOPE=cornod:api
CORS_ORIGINS=https://abdulls95.github.io
